<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="开屏跳过"
            android:textColor="@color/text_main"
            android:textSize="25sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="自动点击启动广告的跳过按钮 · 本地运行 · 不联网"
            android:textColor="@color/text_sub"
            android:textSize="12sp" />

        <!-- 运行状态 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/statusDot"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/dot_off" />

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="无障碍服务未开启"
                    android:textSize="17sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvStatusDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="点击下方按钮，在系统设置里找到「开屏跳过」并开启"
                android:textColor="@color/text_sub"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnOpenSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_button_primary"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="13dp"
                android:text="开启无障碍服务"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 基础设置 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="基础设置"
                android:textColor="@color/text_main"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Switch
                android:id="@+id/switchEnabled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="启用自动跳过"
                android:textSize="14sp" />

            <Switch
                android:id="@+id/switchAggressive"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="兼容模式（提升漏跳 App 的命中率）"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="若某些 App 总是跳不过，打开它：延长扫描时间、放宽按钮识别。可能略增误触，建议只对需要的 App 临时开启。"
                android:textColor="@color/text_sub"
                android:textSize="12sp" />

            <Switch
                android:id="@+id/switchGesture"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="坐标点击兜底"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="当跳过按钮是自定义绘制、无法直接点击的控件时，改用坐标轻点。关闭后可降低误触概率。"
                android:textColor="@color/text_sub"
                android:textSize="12sp" />

            <Switch
                android:id="@+id/switchToast"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="跳过时显示提示"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- 跳过关键词 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="跳过关键词"
                android:textColor="@color/text_main"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="每行一条（也支持逗号分隔）。按钮文字、描述或控件 id 命中即视为广告跳过按钮。带倒计时的「跳过 5s」同样能命中。"
                android:textColor="@color/text_sub"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etKeywords"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_input"
                android:gravity="top|start"
                android:inputType="textMultiLine|textNoSuggestions"
                android:lines="6"
                android:maxLines="10"
                android:padding="12dp"
                android:scrollbars="vertical"
                android:textColor="@color/text_main"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnSaveKeywords"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button_primary"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="10dp"
                    android:text="保存规则"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />

                <View
                    android:layout_width="10dp"
                    android:layout_height="1dp" />

                <Button
                    android:id="@+id/btnResetKeywords"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button_secondary"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="10dp"
                    android:text="恢复默认"
                    android:textAllCaps="false"
                    android:textColor="@color/primary"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 应用白名单 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="应用白名单（不跳过）"
                android:textColor="@color/text_main"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="若某个应用被误触（例如支付、银行、引导页），把它的包名加到这里。包名可在「应用信息」页查看，或用 adb 执行 dumpsys window 查看当前前台窗口。"
                android:textColor="@color/text_sub"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etPackage"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input"
                    android:hint="例如 com.example.app"
                    android:inputType="text|textNoSuggestions"
                    android:padding="10dp"
                    android:singleLine="true"
                    android:textColor="@color/text_main"
                    android:textColorHint="#9AA5B4"
                    android:textSize="13sp" />

                <View
                    android:layout_width="10dp"
                    android:layout_height="1dp" />

                <Button
                    android:id="@+id/btnAddPackage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_button_primary"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingLeft="18dp"
                    android:paddingTop="10dp"
                    android:paddingRight="18dp"
                    android:paddingBottom="10dp"
                    android:text="添加"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llWhitelist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- 运行统计 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="运行统计"
                android:textColor="@color/text_main"
                android:textSize="15sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="累计跳过"
                        android:textColor="@color/text_sub"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvTotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/primary"
                        android:textSize="28sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="今日跳过"
                        android:textColor="@color/text_sub"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvToday"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/primary"
                        android:textSize="28sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="最近一次跳过："
                android:textColor="@color/text_sub"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvLastSkip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="暂无记录"
                android:textColor="@color/text_main"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnResetStats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_button_secondary"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="10dp"
                android:text="清零统计"
                android:textAllCaps="false"
                android:textColor="@color/primary"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- 后台保活 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="保持后台可用"
                android:textColor="@color/text_main"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="部分国产 ROM 会冻结无障碍服务。若发现用一段时间后失效，请把本应用加入电池优化白名单、自启动白名单，并在多任务列表里锁定。"
                android:textColor="@color/text_sub"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnBattery"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button_secondary"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="10dp"
                    android:text="电池优化设置"
                    android:textAllCaps="false"
                    android:textColor="@color/primary"
                    android:textSize="13sp" />

                <View
                    android:layout_width="10dp"
                    android:layout_height="1dp" />

                <Button
                    android:id="@+id/btnAppDetail"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button_secondary"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="10dp"
                    android:text="应用详情页"
                    android:textAllCaps="false"
                    android:textColor="@color/primary"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 诊断日志 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="诊断日志"
                android:textColor="@color/text_main"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="记录最近 30 条扫描结果。某个 App 没跳过时，可回到这里看它是否检测到窗口、是否找到按钮。只存本机。"
                android:textColor="@color/text_sub"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvDiag"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_input"
                android:lineSpacingExtra="3dp"
                android:maxLines="12"
                android:padding="12dp"
                android:scrollbars="vertical"
                android:text="暂无日志，打开带开屏广告的 App 后会自动记录。"
                android:textColor="@color/text_main"
                android:textIsSelectable="true"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnClearDiag"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_button_secondary"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="10dp"
                android:text="清空日志"
                android:textAllCaps="false"
                android:textColor="@color/primary"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- 使用提示 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="使用提示"
                android:textColor="@color/text_main"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="4dp"
                android:text="1. 开启后打开任意带开屏广告的 App 即可验证，统计数字会增加。\n2. 若某个 App 有时跳不过：先打开「兼容模式」，并查看上方「诊断日志」——看它是否检测到窗口、是否找到按钮：\n   · 没有「检测到窗口」→ 该 App 可能冻结了服务，请把本应用加入电池优化与自启动白名单；\n   · 有窗口但「未找到按钮」→ 在关键词里补充该按钮的文字，或开启兼容模式；\n   · 有「点击失败」→ 开启坐标点击兜底。\n3. Android 13 及以上若提示「受限设置」而无法开启，请进入应用详情页右上角菜单，选择「允许受限设置」。\n4. 若出现误触，把该 App 加入白名单，或关闭兼容模式与坐标兜底、精简关键词。\n5. 不需要 Root，也不修改任何其他应用；关闭无障碍开关即完全停用。"
                android:textColor="@color/text_sub"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:paddingBottom="12dp"
            android:text="仅供个人设备自用与学习研究。本应用不联网、不采集数据，请勿用于绕过付费内容或商业分发。"
            android:textColor="@color/text_sub"
            android:textSize="11sp" />

    </LinearLayout>
</ScrollView>
